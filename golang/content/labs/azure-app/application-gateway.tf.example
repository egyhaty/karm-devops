# Optional paid L7 experiment: PRIVATE HTTP listener, not production TLS ingress.
# Activate only after cost/region review, and remove via Terraform before deleting file.
resource "azurerm_subnet" "gateway" {
  name                 = "application-gateway"
  resource_group_name  = azurerm_resource_group.lab.name
  virtual_network_name = azurerm_virtual_network.lab.name
  address_prefixes     = ["10.60.30.0/24"]
}
resource "azurerm_public_ip" "gateway" {
  name                = "gateway-platform-ip"
  location            = var.location
  resource_group_name = azurerm_resource_group.lab.name
  allocation_method   = "Static"
  sku                 = "Standard"
}
resource "azurerm_application_gateway" "extension" {
  name                = "lab-http-gateway"
  location            = var.location
  resource_group_name = azurerm_resource_group.lab.name
  sku {
    name     = "Standard_v2"
    tier     = "Standard_v2"
    capacity = 1
  }
  gateway_ip_configuration {
    name      = "gateway-subnet"
    subnet_id = azurerm_subnet.gateway.id
  }
  frontend_ip_configuration {
    name                 = "platform-public"
    public_ip_address_id = azurerm_public_ip.gateway.id
  }
  frontend_ip_configuration {
    name                          = "private"
    subnet_id                     = azurerm_subnet.gateway.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.60.30.10"
  }
  frontend_port {
    name = "http"
    port = 80
  }
  backend_address_pool {
    name         = "internal-lb"
    ip_addresses = [azurerm_lb.app.frontend_ip_configuration[0].private_ip_address]
  }
  backend_http_settings {
    name                  = "app"
    cookie_based_affinity = "Disabled"
    port                  = 8080
    protocol              = "Http"
    request_timeout       = 10
    probe_name            = "health"
  }
  probe {
    name                = "health"
    protocol            = "Http"
    host                = "localhost"
    path                = "/healthz"
    interval            = 30
    timeout             = 10
    unhealthy_threshold = 3
  }
  http_listener {
    name                           = "private-http"
    frontend_ip_configuration_name = "private"
    frontend_port_name             = "http"
    protocol                       = "Http"
  }
  request_routing_rule {
    name                       = "app"
    priority                   = 100
    rule_type                  = "Basic"
    http_listener_name         = "private-http"
    backend_address_pool_name  = "internal-lb"
    backend_http_settings_name = "app"
  }
}
# In private tfvars, add the gateway subnet to app_client_cidrs alongside the app subnet.
