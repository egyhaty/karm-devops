# Optional paid extension. Copy to vmss.tf only in a sandbox after cost/quota review.
# Adds a second application compute pool; does not remove the single-VM drill.
variable "vmss_zones" {
  type    = list(string)
  default = ["1", "2"] # Check selected region/SKU supports these zones first.
}
resource "azurerm_linux_virtual_machine_scale_set" "extension" {
  name                            = "lab-vmss"
  location                        = var.location
  resource_group_name             = azurerm_resource_group.lab.name
  sku                             = var.vm_size
  instances                       = 2
  zones                           = var.vmss_zones
  zone_balance                    = true
  admin_username                  = "laboperator"
  disable_password_authentication = true
  upgrade_mode                    = "Manual" # Explicit bounded rollout exercise below.
  health_probe_id                 = azurerm_lb_probe.app.id
  identity { type = "SystemAssigned" }
  admin_ssh_key {
    username   = "laboperator"
    public_key = file(pathexpand(var.ssh_public_key_path))
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }
  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts-gen2"
    version   = "latest" # Pin an approved image version for repeatable releases.
  }
  network_interface {
    name    = "app"
    primary = true
    ip_configuration {
      name                                   = "private"
      primary                                = true
      subnet_id                              = azurerm_subnet.app.id
      load_balancer_backend_address_pool_ids = [azurerm_lb_backend_address_pool.app.id]
    }
  }
  custom_data = base64encode(templatefile("${path.module}/cloud-init.yaml.tftpl", {
    app = file("${path.module}/app.py"), storage_account = var.storage_account_name
  }))
  depends_on = [azurerm_nat_gateway_public_ip_association.app, azurerm_subnet_nat_gateway_association.app]
}
resource "azurerm_role_assignment" "vmss_blob" {
  scope                = azurerm_storage_account.data.id
  role_definition_name = "Storage Blob Data Reader"
  principal_id         = azurerm_linux_virtual_machine_scale_set.extension.identity[0].principal_id
}
