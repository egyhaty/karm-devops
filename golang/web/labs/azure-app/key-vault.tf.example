# Optional paid private-vault exercise, activated only in a sandbox.
variable "vault_name" { type = string }
variable "vault_data_role" {
  type    = string
  default = "Key Vault Secrets User"
  validation {
    condition     = contains(["Key Vault Secrets User", "Key Vault Secrets Officer"], var.vault_data_role)
    error_message = "Choose the read role, or explicitly use the temporary lab seed role."
  }
}
data "azurerm_client_config" "lab" {}
resource "azurerm_key_vault" "extension" {
  name                          = var.vault_name
  location                      = var.location
  resource_group_name           = azurerm_resource_group.lab.name
  tenant_id                     = data.azurerm_client_config.lab.tenant_id
  sku_name                      = "standard"
  rbac_authorization_enabled    = true
  public_network_access_enabled = false
  soft_delete_retention_days    = 7
  purge_protection_enabled      = false # Follow tenant policy; don't bypass enforced protection.
}
resource "azurerm_private_dns_zone" "vault" {
  name                = "privatelink.vaultcore.azure.net"
  resource_group_name = azurerm_resource_group.lab.name
}
resource "azurerm_private_dns_zone_virtual_network_link" "vault" {
  name                  = "vault-vnet-link"
  resource_group_name   = azurerm_resource_group.lab.name
  private_dns_zone_name = azurerm_private_dns_zone.vault.name
  virtual_network_id    = azurerm_virtual_network.lab.id
}
resource "azurerm_private_endpoint" "vault" {
  name                = "vault-endpoint"
  location            = var.location
  resource_group_name = azurerm_resource_group.lab.name
  subnet_id           = azurerm_subnet.endpoints.id
  private_service_connection {
    name                           = "vault"
    private_connection_resource_id = azurerm_key_vault.extension.id
    subresource_names              = ["vault"]
    is_manual_connection           = false
  }
  private_dns_zone_group {
    name                 = "vault-zone"
    private_dns_zone_ids = [azurerm_private_dns_zone.vault.id]
  }
}
resource "azurerm_role_assignment" "vault" {
  scope                = azurerm_key_vault.extension.id
  role_definition_name = var.vault_data_role
  principal_id         = azurerm_linux_virtual_machine.app.identity[0].principal_id
}
output "vault_name" { value = azurerm_key_vault.extension.name }
