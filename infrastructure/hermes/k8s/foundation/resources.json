{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "hermes",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.36"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "hermes-data",
        "namespace": "hermes",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "longhorn",
        "resources": {
          "requests": {
            "storage": "20Gi"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hermes-ingress",
        "namespace": "hermes"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ],
        "ingress": []
      }
    }
  ]
}
