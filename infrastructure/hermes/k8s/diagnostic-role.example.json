{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {"name": "hermes-diagnostics", "namespace": "REPLACE_TARGET_NAMESPACE"},
  "rules": [
    {"apiGroups": [""], "resources": ["pods", "pods/log", "events", "services", "endpoints", "persistentvolumeclaims"], "verbs": ["get", "list"]},
    {"apiGroups": ["apps"], "resources": ["deployments", "replicasets", "statefulsets", "daemonsets"], "verbs": ["get", "list"]},
    {"apiGroups": ["batch"], "resources": ["jobs", "cronjobs"], "verbs": ["get", "list"]}
  ]
}
